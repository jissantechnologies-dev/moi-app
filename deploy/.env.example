# Copy to /opt/moi-book/.env on the server and fill in. Never commit the real file.
POSTGRES_PASSWORD=
JWT_SECRET=

# Optional. Without SMTP the server logs confirmation and reset links instead of
# emailing them, which blocks public sign-up from completing on its own.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Moi Book <no-reply@jissantechnologies.online>

# Vercel sets these in its dashboard instead of a file. DATABASE_URL there must
# be Neon's pooled (-pooler) host; the compose file builds its own from
# POSTGRES_PASSWORD, so it is not listed above.
