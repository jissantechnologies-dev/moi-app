{
  "expo": {
    "name": "Moi Book",
    "slug": "moi-book",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.gvndemo.moibook",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSContactsUsageDescription": "Moi Book uses your contacts so you can pick a person instead of typing their phone number."
      }
    },
    "android": {
      "package": "com.gvndemo.moibook",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-contacts",
        {
          "contactsPermission": "Moi Book uses your contacts so you can pick a person instead of typing their phone number."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Moi Book uses your photos so you can attach a picture to an entry.",
          "cameraPermission": "Moi Book uses your camera so you can photograph a gift or a note and attach it to an entry.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F1"
        }
      ],
      "expo-sqlite"
    ]
  }
}
