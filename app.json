{
  "expo": {
    "name": "Moi Book",
    "slug": "moi-book",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSContactsUsageDescription": "Moi Book uses your contacts so you can pick a person instead of typing their phone number."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-contacts",
        {
          "contactsPermission": "Moi Book uses your contacts so you can pick a person instead of typing their phone number."
        }
      ],
      "expo-sqlite"
    ]
  }
}
